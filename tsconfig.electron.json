{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "types": ["node"],
    "lib": ["ES2020", "DOM"]
  },
  "include": ["electron/**/*", "src/shared/**/*", "src/core/**/*"]
}
