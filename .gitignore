# deps
node_modules/
.agent/
.venv/
.opencode/
.claude/
opencode.json

CHANGELOG.md

# Собранные Android-артефакты (GeckoView-спайк, Фаза 7б). APK весит десятки
# мегабайт и в репозитории ему не место. Иконки build/icon.* отслеживаются
# намеренно, поэтому правило точечное.
build/*.apk
build/*.aab
build/apk/
build/*.idsig

# build (electron-builder кладёт установщик и portable в dist/)
dist/
build-renderer/
build-android/
dist-electron/
out/
# Промежуточная сборка electron-builder внутри проекта (build-exe.mjs).
# Отдельный каталог нужен из-за EPERM на переименовании win-unpacked.tmp:
# в %TEMP% система фильтрует переименование иначе. Но %TEMP% — не наше место:
# там копируется 400 МБ, которые пользователь потом вручную чистит.
.build-staging/
*.tsbuildinfo

# electron-builder cache / win code-sign
.cache/
*.exe
*.msi
*.nsis.*

# Бэкап локальных знаний, если нет APPDATA (обычно цепочка — %APPDATA%).
.appdata/

# local DB / user data (цены и история — локальные, в репо не нужны)
*.db
*.sqlite
*.sqlite-journal
*.db-journal
app-data/

# env / secrets (API-ключи Firecrawl/Apify и т.п.)
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Playwright: браузеры качаются ТОЛЬКО в проект
.playwright-browsers/
# Сетевые дампы содержат живые токены сессии (Passport-*, qrator_*),
# их нельзя коммитить в публичный репозиторий.
*.har
*.har.json
# Скриншоты проверок интерфейса (Playwright, dev-сервер :5173).
shots/
# Отчёты покрытия (npm run test:coverage).
coverage/
.nyc_output/